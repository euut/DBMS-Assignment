<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <%- include('partials/navbar') %>

  <div class="container" style="margin-top: 80px;">

    <!-- User Info -->
    <div class="card mb-4 shadow-sm">
      <div class="card-header bg-primary text-white">
        <h4>User Information</h4>
      </div>
      <div class="card-body">
        <div class="row mb-2">
          <div class="col-md-3 fw-bold">Name:</div>
          <div class="col-md-9"><%= locals.user.name %></div>
        </div>
        <div class="row mb-2">
          <div class="col-md-3 fw-bold">Username:</div>
          <div class="col-md-9"><%= locals.user.username %></div>
        </div>
        <div class="row mb-2">
          <div class="col-md-3 fw-bold">Email:</div>
          <div class="col-md-9"><%= locals.user.email %></div>
        </div>
        <div class="row mb-2">
          <div class="col-md-3 fw-bold">Password:</div>
          <div class="col-md-9"><%= locals.user.password %></div>
        </div>
        <div class="row mb-2">
          <div class="col-md-3 fw-bold">Birthdate:</div>
          <div class="col-md-9"><%= new Date(locals.user.birthdate).toLocaleDateString() %></div>
        </div>
        <div class="row mb-2">
          <div class="col-md-3 fw-bold">Address:</div>
          <div class="col-md-9"><%= locals.user.address %></div>
        </div>
      </div>
    </div>

    <!-- Transactions Table -->
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h4>Your Transactions</h4>
      </div>
      <div class="card-body">
        <form action="/dashboard/search" method="GET">
          <div class="mb-3">
            <input type="text" id="search" name="search" class="form-control" placeholder="Search">
          </div>
        </form>
        <% if (locals.transactions.length === 0) { %>
          <p>No transactions found.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Symbol</th>
                  <th>Transaction Code</th>
                  <th>Amount</th>
                  <th>Price</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody>
                <% locals.transactions.forEach(transactionGroup => { %>
                  <% transactionGroup.transactions.forEach(t => { %>
                    <tr>
                      <td><%= new Date(t.date).toLocaleDateString() %></td>
                      <td><%= t.symbol %></td>
                      <td><%= t.transaction_code %></td>
                      <td><%= t.amount %></td>
                      <td>$<%= parseFloat(t.price).toFixed(2) %></td>
                      <td>$<%= parseFloat(t.total).toFixed(2) %></td>
                    </tr>
                  <% }); %>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</body>
</html>